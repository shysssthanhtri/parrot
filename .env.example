# Public site URL (SEO metadata, sitemap, Open Graph absolute URLs)
# NEXT_PUBLIC_APP_URL=https://parrot.shyss.space

# Auth (NextAuth)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Database
DATABASE_URL=postgresql://parrot:parrot@localhost:5432/parrot?schema=public

# LLM provider (script generation, topic color suggestion)
# vercel-ai-gateway (default) | gemini
# LLM_PROVIDER=vercel-ai-gateway
AI_GATEWAY_API_KEY=

# Required only when LLM_PROVIDER=gemini (direct Google Gemini API)
GEMINI_API_KEY=

# Chatterbox TTS (Modal)
CHATTERBOX_API_URL=
CHATTERBOX_API_KEY=

# Voice audio storage
# Defaults to "local" in development and "r2" in production.
# STORAGE_DRIVER=local
# LOCAL_STORAGE_DIR=.local-storage

# Cloudflare R2 (required when STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional; defaults to https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_ENDPOINT=
